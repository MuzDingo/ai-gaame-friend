# Copy this file to ".env" and fill in the two keys. Never share .env with anyone.

# From the Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=paste-your-discord-bot-token-here

# From console.anthropic.com > API Keys
ANTHROPIC_API_KEY=paste-your-claude-api-key-here

# Optional settings (the defaults are fine to start)
# Which Claude model the friend uses. claude-sonnet-5-5 or claude-haiku-5-5 cost less.
CLAUDE_MODEL=claude-opus-5-5
# How many recent messages per channel it remembers during a chat
HISTORY_LENGTH=20
# Word you type before commands, like "!friend show"
COMMAND_PREFIX=!friend
# Optional: channel IDs (comma separated) where the friend answers every message.
# Leave blank and it answers only when @mentioned or in direct messages.
FRIEND_CHANNEL_IDS=

# Voice chat (optional). From console.deepgram.com > API Keys
DEEPGRAM_API_KEY=
# How long a pause (in milliseconds) means you've finished talking
VOICE_SILENCE_MS=900

# Memory (optional). Save memories after this many messages from a person
MEMORY_SAVE_EVERY=6
# Most facts it keeps about one person
MEMORY_MAX_FACTS=40
